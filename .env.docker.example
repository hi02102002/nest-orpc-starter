# Public host ports
SERVER_PORT=3000
WEB_PORT=3001

# Browser-facing URLs
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
VITE_SERVER_URL=http://localhost:3000

# Server secrets and external PostgreSQL connection
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/petshop
