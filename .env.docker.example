# Images pulled by the deploy workflow (leave unset to build locally)
# SERVER_IMAGE=<dockerhub-user>/app-server:latest
# WEB_IMAGE=<dockerhub-user>/nest-orpc-starter-web:latest

# Public host ports
SERVER_PORT=8080
WEB_PORT=3333

# Browser-facing URLs
BETTER_AUTH_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:3333
VITE_SERVER_URL=http://localhost:8080

# Server secrets and external PostgreSQL connection
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/app
