{
	"name": "nest-orpc-starter",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"start": "turbo run start --ui=stream",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:up": "docker compose -f compose.dev.yaml up -d --wait && docker compose -f compose.dev.yaml run --rm s3-init",
		"db:down": "docker compose -f compose.dev.yaml down",
		"db:push": "turbo run db:push -F @app/db --",
		"db:studio": "turbo run db:studio -F @app/db --",
		"db:seed-admin": "pnpm --filter @app/db db:seed-admin",
		"db:generate": "turbo run db:generate -F @app/db --",
		"db:migrate": "turbo run db:migrate -F @app/db --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"generate:crud": "pnpm --filter @app/cli generate:crud",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && pnpm run auth:generate",
		"check": "biome check --write ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@app/config": "workspace:*",
		"@types/node": "^26.4.1",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "pnpm@11.9.0"
}
